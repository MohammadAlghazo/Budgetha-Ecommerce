  "shortcuts": [
    {
      "name": "Browse the shop",
      "short_name": "Shop",
      "url": "/shop?source=pwa-shortcut",
      "icons": [{ "src": "icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Today's deals",
      "short_name": "Deals",
      "url": "/shop?deals=1&source=pwa-shortcut",
      "icons": [{ "src": "icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "My cart",
      "short_name": "Cart",
